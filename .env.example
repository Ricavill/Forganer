# Copy this file to .env and fill in real values before running docker-compose.

# Required
SECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=

# Only needed if running the API outside Docker (docker-compose sets this itself)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/friends_activity_planner

# Optional — how the API reaches the MCP server (docker-compose sets this itself)
MCP_SERVER_URL=http://localhost:8765/mcp

# Optional — calendar-invite emails via Resend (https://resend.com). Leave blank to disable;
# the assistant will simply not offer to email invites when this isn't set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Friends Activity Planner <onboarding@resend.dev>
